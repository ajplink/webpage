---
/**
 * Join / Tornar-me Sócio — the benefits of being an associate and how to
 * sign up. Content from the `pages` collection (entry slug: `join`); the
 * fee card and CTAs live here because they are interface, not prose.
 */
import { SITE, type Locale } from '../config/site';
import { localizedEntry } from '../lib/content';
import { href } from '../i18n/routes';
import { t } from '../i18n';
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Prose from '../components/Prose.astro';
import Icon from '../components/Icon.astro';
import Squiggle from '../components/Squiggle.astro';
import MemberForm from '../components/MemberForm.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const page = await localizedEntry('pages', locale, 'join');
if (!page) throw new Error('Missing `pages/join` content entry');
const { Content } = await render(page);
---

<Base {locale} title={page.data.title} description={page.data.summary ?? ''} routeKey="join">
  <article class="container page">
    <header class="page-head">
      <h1>{page.data.title}</h1>
      {page.data.summary && <p class="lead">{page.data.summary}</p>}
    </header>

    <div class="page-grid">
      <Prose>
        <Content />
      </Prose>

      <aside class="join-aside">
        <div class="panel join-card" style="--panel-color: var(--palette-pink)">
          <Icon name="star" size={28} />
          <h2>{t(locale, 'join.fee')}</h2>
          <p class="fee">1 € <span>/ ano</span></p>
          <p class="fee-note">A mesma quota para todos.</p>
          <Squiggle />
          <div class="join-actions">
            <a class="button button--ghost" href={`mailto:${SITE.contactEmail}`}>{t(locale, 'join.emailLabel')}</a>
          </div>
          <p class="quiet">
            <a href={href(locale, 'members')}>{t(locale, 'join.alreadyMember')}</a>
          </p>
        </div>
      </aside>
    </div>

    <section class="join-form" aria-labelledby="join-form-title">
      <h2 id="join-form-title">{t(locale, 'form.title')}</h2>
      <MemberForm {locale} />
    </section>
  </article>
</Base>

<style>
  .page {
    padding-block: var(--space-xl);
  }

  .page-head {
    margin-bottom: var(--space-l);
  }

  .page-head .lead {
    margin-top: var(--space-s);
    color: var(--color-text-muted);
  }

  .page-grid {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    align-items: start;
  }

  .join-card {
    display: grid;
    gap: var(--space-2xs);
    color: var(--color-text);
  }

  .join-card h2 {
    font-size: var(--step-1);
  }

  .fee {
    font-family: var(--font-display);
    font-size: var(--step-3);
    line-height: 1;
    color: var(--color-accent);
  }

  .fee span {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }

  .fee-note {
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }

  .placeholder {
    font-family: var(--font-mono);
    font-size: 0.85em;
  }

  .join-actions {
    display: grid;
    gap: var(--space-2xs);
    margin-top: var(--space-2xs);
  }

  .quiet {
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }

  .join-form {
    max-width: 52rem;
    margin-top: var(--space-2xl);
  }

  .join-form h2 {
    margin-bottom: var(--space-m);
    font-size: var(--step-2);
  }

  @media (max-width: 52rem) {
    .page-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
