---
/**
 * Home — the one orchestrated motion moment (the wordmark writes itself),
 * then events, news and projects, each in its palette colour, and one quiet
 * door to membership (never a sales pitch).
 */
import { SITE, type Locale } from '../config/site';
import { t } from '../i18n';
import { href } from '../i18n/routes';
import { eventsByStatus, projectLeads, projects, publishedNews } from '../lib/content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import EventItem from '../components/EventItem.astro';
import NewsItem from '../components/NewsItem.astro';
import ProjectCard from '../components/ProjectCard.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const [{ upcoming }, news, allProjects] = await Promise.all([
  eventsByStatus(locale),
  publishedNews(locale),
  projects(locale),
]);

const featuredEvents = upcoming.slice(0, 3);
const latestNews = news.slice(0, 3);
const featuredProjects = allProjects.slice(0, 3);
const leadNames = new Map<string, string[]>();
for (const project of featuredProjects) {
  leadNames.set(project.slug, (await projectLeads(project, locale)).map((m) => m.data.name));
}
---

<Base
  {locale}
  title={SITE.name}
  description={SITE.description[locale]}
  routeKey="home"
>
  <Hero
    title={SITE.tagline[locale]}
    lead={SITE.description[locale]}
  >
    <a class="button" href={href(locale, 'projects')}>{t(locale, 'home.cta')}</a>
    <a class="button button--ghost" href={href(locale, 'about')}>{t(locale, 'home.ctaSecondary')}</a>
  </Hero>

  <Section
    title={t(locale, 'home.upcomingEvents')}
    id="upcoming-events"
    href={href(locale, 'events')}
    linkLabel={t(locale, 'home.viewAll')}
    accent="var(--palette-blue)"
  >
    {
      featuredEvents.length > 0 ? (
        <ul class="grid">
          {featuredEvents.map((event) => (
            <EventItem {locale} {event} />
          ))}
        </ul>
      ) : (
        <p>{t(locale, 'home.empty')}</p>
      )
    }
  </Section>

  <Section
    title={t(locale, 'home.latestNews')}
    id="latest-news"
    href={href(locale, 'news')}
    linkLabel={t(locale, 'home.viewAll')}
    accent="var(--palette-orange)"
  >
    {
      latestNews.length > 0 ? (
        <ul class="grid">
          {latestNews.map((item) => (
            <NewsItem {locale} {item} />
          ))}
        </ul>
      ) : (
        <p>{t(locale, 'home.empty')}</p>
      )
    }
  </Section>

  <Section
    title={t(locale, 'home.featuredProjects')}
    id="featured-projects"
    href={href(locale, 'projects')}
    linkLabel={t(locale, 'home.viewAll')}
    accent="var(--palette-green)"
  >
    {
      featuredProjects.length > 0 ? (
        <ul class="grid">
          {featuredProjects.map((project) => (
            <ProjectCard {locale} {project} leads={leadNames.get(project.slug) ?? []} />
          ))}
        </ul>
      ) : (
        <p>{t(locale, 'home.empty')}</p>
      )
    }
  </Section>

  <!-- one quiet door to membership, never a pitch -->
  <aside class="quiet-join container">
    <p>
      {t(locale, 'home.joinQuiet')} <a class="link-arrow" href={href(locale, 'join')}>{t(locale, 'nav.join')}</a>
    </p>
  </aside>
</Base>

<style>
  /* The main-page cards are puzzle pieces (kits assembling, problems solved
     together): jigsaw silhouette with a tab right + bottom and a notch left +
     top, so a row of them fits together. Shape and outline are masked pseudo
     layers behind the content — the text is never clipped. Knob and gap come
     from tokens (--puzzle-knob / --space-xs). */
  .grid {
    gap: var(--space-xs);
  }

  .grid :global(.card) {
    position: relative;
    isolation: isolate;
    background: none;
    border: none;
    border-radius: 0;
  }

  .grid :global(.card)::before,
  .grid :global(.card)::after {
    content: '';
    position: absolute;
    pointer-events: none;
    /* One jigsaw piece — Temani Afif's CSS jigsaw recipe
       (css-shape.com/puzzle/), adapted: the box grows by --r on the right
       and bottom to house the tab strips (gradients never paint outside
       their layer box), the body is a sized tile that carries the top
       notch in its base layer, the left notch is cut with `intersect`
       (commutative — no composite-order traps), and the two tab tiles
       are added last. Tabs right+bottom, notches left+top, so a row or
       column of cards interlocks. */
    --r: var(--puzzle-knob);
    inset: 0 calc(-1 * var(--r)) calc(-1 * var(--r)) 0;
    mask-image:
      radial-gradient(var(--r), #000 calc(100% - 1px), #0000),
      radial-gradient(var(--r), #000 calc(100% - 1px), #0000),
      radial-gradient(var(--r) at left 50%, #0000 calc(100% - 1px), #000),
      radial-gradient(var(--r) at 50% top, #0000 calc(100% - 1px), #000);
    mask-position:
      100% calc(50% - var(--r) / 2),
      calc(50% - var(--r) / 2) 100%,
      0 0,
      0 0;
    mask-size:
      calc(2 * var(--r)) calc(2 * var(--r)),
      calc(2 * var(--r)) calc(2 * var(--r)),
      calc(100% - var(--r)) calc(100% - var(--r)),
      calc(100% - var(--r)) calc(100% - var(--r));
    mask-repeat: no-repeat;
    mask-composite: add, add, intersect, add;
  }

  /* the hairline outline: the same silhouette grown 1.5px, behind the fill */
  .grid :global(.card)::before {
    inset: -1.5px calc(-1 * var(--r) - 1.5px) calc(-1 * var(--r) - 1.5px) -1.5px;
    z-index: -2;
    background-color: var(--color-border);
    transition: background-color var(--duration) var(--ease);
  }

  .grid :global(.card):hover::before {
    background-color: color-mix(in srgb, var(--color-primary) 35%, var(--color-border));
  }

  /* the fill */
  .grid :global(.card)::after {
    z-index: -1;
    background-color: var(--color-surface);
  }

  .quiet-join {
    padding-block: var(--space-l);
    font-size: var(--step-0);
    color: var(--color-text-muted);
    border-top: var(--border-width) solid var(--color-border);
  }
</style>
