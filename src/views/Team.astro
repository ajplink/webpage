---
/**
 * Team — Órgãos Sociais first (Direção, Conselho Fiscal, Mesa da Assembleia),
 * then the departments. Each body gets an auto-scrolling rail of people
 * (pure CSS marquee: pauses on hover/focus, manual scroll under reduced
 * motion). Names speak for themselves — no filler copy.
 */
import type { Locale } from '../config/site';
import {
  teamByDepartment,
  ORGAOS_SOCIAIS,
  DEPARTMENTS,
  type Department,
} from '../lib/content';
import { t } from '../i18n';
import Base from '../layouts/Base.astro';
import TeamCard from '../components/TeamCard.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const groups = await teamByDepartment(locale);
const title = t(locale, 'nav.team');

const bodies = (wanted: readonly Department[]) =>
  wanted.map((d) => groups.find((g) => g.department === d)).filter((g) => g !== undefined);

const organs = bodies(ORGAOS_SOCIAIS);
const depts = bodies(DEPARTMENTS);
---

<Base {locale} {title} description={t(locale, 'team.departments')} routeKey="team">
  <div class="container page">
    <header class="page-head">
      <h1>{title}</h1>
    </header>

    <section aria-labelledby="orgaos">
      <h2 id="orgaos" class="group-title">{t(locale, 'team.organs')}</h2>
      {
        organs.map((group) => (
          <div class="body">
            <h3 class="body-title">{t(locale, `dept.${group.department}` as 'dept.Direção')}</h3>
            <div class="carousel">
              <ul class="carousel-track" style={`--items: ${group.members.length}`}>
                {group.members.map((member) => (
                  <TeamCard {member} {locale} />
                ))}
                {group.members.map((member) => (
                  <TeamCard {member} {locale} clone />
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </section>

    <section aria-labelledby="depts">
      <h2 id="depts" class="group-title">{t(locale, 'team.depts')}</h2>
      {
        depts.map((group) => (
          <div class="body">
            <h3 class="body-title">{t(locale, `dept.${group.department}` as 'dept.Direção')}</h3>
            <div class="carousel">
              <ul class="carousel-track" style={`--items: ${group.members.length}`}>
                {group.members.map((member) => (
                  <TeamCard {member} {locale} />
                ))}
                {group.members.map((member) => (
                  <TeamCard {member} {locale} clone />
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </section>
  </div>
</Base>

<style>
  .page {
    padding-block: var(--space-xl);
  }

  .page-head {
    margin-bottom: var(--space-xl);
  }

  .group-title {
    margin-bottom: var(--space-m);
    font-size: var(--step-1);
    color: var(--color-accent);
  }

  .body + .body {
    margin-top: var(--space-l);
  }

  .body-title {
    margin-bottom: var(--space-s);
    font-size: var(--step-2);
  }

  /* Auto-scrolling rail: the content is rendered twice and slides by half. */
  .carousel {
    overflow: hidden;
  }

  .carousel-track {
    display: flex;
    width: max-content;
    padding-block: var(--space-3xs) var(--space-s);
    animation: marquee calc(var(--items) * 7s) linear infinite;
    animation-play-state: running;
  }

  .carousel-track > :global(*) {
    width: min(19rem, 72vw);
    flex: none;
    margin-right: var(--space-m);
  }

  .carousel:hover .carousel-track,
  .carousel:focus-within .carousel-track {
    animation-play-state: paused;
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  /* Reduced motion: no marquee — the rail scrolls by hand instead. */
  @media (prefers-reduced-motion: reduce) {
    .carousel {
      overflow-x: auto;
    }

    .carousel-track {
      animation: none;
    }
  }
</style>
