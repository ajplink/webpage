---
/**
 * Team — one carousel per department, big portraits, full department names.
 * The carousel is plain CSS (scroll-snap + a focusable region): arrow keys
 * scroll it, zero JavaScript.
 */
import type { Locale } from '../config/site';
import { teamByDepartment } from '../lib/content';
import { t } from '../i18n';
import Base from '../layouts/Base.astro';
import TeamCard from '../components/TeamCard.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const groups = await teamByDepartment(locale);
const title = t(locale, 'nav.team');
---

<Base {locale} {title} description={t(locale, 'team.departments')} routeKey="team">
  <div class="container page">
    <header class="page-head">
      <h1>{title}</h1>
    </header>

    {
      groups.map((group) => (
        <section class="department" aria-labelledby={`dept-${group.department}`}>
          <h2 id={`dept-${group.department}`} class="dept-title">{t(locale, `dept.${group.department}` as 'dept.Direção')}</h2>
          <ul class="carousel" tabindex="0" role="group" aria-label={t(locale, `dept.${group.department}` as 'dept.Direção')}>
            {group.members.map((member) => (
              <TeamCard {member} />
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .page {
    padding-block: var(--space-xl);
  }

  .page-head {
    margin-bottom: var(--space-xl);
  }

  .page-head .lead {
    margin-top: var(--space-s);
    color: var(--color-text-muted);
  }

  .department + .department {
    margin-top: var(--space-2xl);
  }

  .dept-title {
    margin-bottom: var(--space-s);
  }

  /* Horizontal card rail: drag, swipe or arrow keys (focusable region). */
  .carousel {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(16rem, 19rem);
    gap: var(--space-m);
    overflow-x: auto;
    padding: var(--space-3xs) var(--space-2xs) var(--space-s);
    margin-inline: calc(-1 * var(--space-2xs));
    list-style: none;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--space-2xs);
    scrollbar-width: thin;
    scrollbar-color: var(--color-border) transparent;
  }

  .carousel > * {
    scroll-snap-align: start;
    height: 100%;
  }

  .carousel:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
    border-radius: var(--radius);
  }

</style>
