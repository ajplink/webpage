---
/**
 * About — a designed page, not a wiki entry: mission statement first, then
 * the prose from the `pages` collection (entry slug: `about`), then the
 * department map (data from ui.ts / lib) with a door to the team page.
 */
import { type Locale } from '../config/site';
import { localizedEntry, DEPARTMENTS, DEPT_ACCENT, type Department } from '../lib/content';
import { href } from '../i18n/routes';
import { t } from '../i18n';
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Prose from '../components/Prose.astro';
import Playground from '../components/Playground.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const page = await localizedEntry('pages', locale, 'about');
if (!page) throw new Error('Missing `pages/about` content entry');
const { Content } = await render(page);
---

<Base {locale} title={page.data.title} description={page.data.summary ?? ''} routeKey="about">
  <article class="container page">
    <header class="page-head">
      <div>
        <h1>{page.data.title}</h1>
        {page.data.summary && <p class="lead">{page.data.summary}</p>}
      </div>
      <img class="head-bulb" src="/lampada.svg" alt="" width="180" height="228" loading="eager" decoding="async" />
    </header>

    <Prose>
      <Content />
    </Prose>

    <Playground {locale} />

    <section class="departments" aria-labelledby="dept-map">
      <h2 id="dept-map">{t(locale, 'team.departments')}</h2>
      <ul class="dept-grid">
        {
          DEPARTMENTS.map((department: Department) => (
            <li class="panel dept-card" style={`--panel-color: ${DEPT_ACCENT[department]}`}>
              <h3>{t(locale, `dept.${department}` as 'dept.Direção')}</h3>
              <p>{t(locale, `desc.${department}` as 'desc.Direção')}</p>
            </li>
          ))
        }
      </ul>
      <p>
        <a class="link-arrow" href={href(locale, 'team')}>{t(locale, 'nav.team')}</a>
      </p>
    </section>
  </article>
</Base>

<style>
  .page {
    padding-block: var(--space-xl);
  }

  .page-head {
    display: grid;
    gap: var(--space-l);
    grid-template-columns: minmax(0, 3fr) minmax(0, 1fr);
    align-items: center;
    margin-bottom: var(--space-xl);
  }

  .page-head .lead {
    margin-top: var(--space-s);
    color: var(--color-text-muted);
  }

  .head-bulb {
    width: min(100%, 11rem);
    height: auto;
    justify-self: end;
    transform: rotate(6deg);
  }

  .departments {
    max-width: var(--container);
    margin-top: var(--space-2xl);
    padding-top: var(--space-l);
    border-top: var(--border-width) solid var(--color-border);
  }

  .departments h2 {
    margin-bottom: var(--space-m);
  }

  .dept-grid {
    display: grid;
    gap: var(--space-s);
    padding: 0;
    margin: 0 0 var(--space-m);
    list-style: none;
    grid-template-columns: repeat(auto-fill, minmax(min(15rem, 100%), 1fr));
  }

  .dept-card {
    display: grid;
    gap: var(--space-3xs);
    padding: var(--space-s);
  }

  .dept-card h3 {
    font-size: var(--step-0);
  }

  .dept-card p {
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }

  @media (max-width: 48rem) {
    .page-head {
      grid-template-columns: 1fr;
    }

    .head-bulb {
      width: 9rem;
      justify-self: start;
    }
  }
</style>
