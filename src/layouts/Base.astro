---
/**
 * Base layout — the only place that owns the document skeleton:
 * <head>, skip link, header, <main> and footer.
 */
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/fraunces/wght.css';
import '../styles/tokens.css';
import '../styles/global.css';

import type { Locale } from '../config/site';
import type { RouteKey } from '../i18n/routes';
import { htmlLang, t } from '../i18n';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  routeKey: RouteKey;
  entrySlug?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const { locale, title, description, routeKey, entrySlug, image, type, noindex } = Astro.props;
---

<!doctype html>
<html lang={htmlLang(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#12151b" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Theme bootstrap: the one documented progressive enhancement (AGENTS.md).
         Applies a pinned light/dark scheme before first paint; without JS the
         OS preference decides. -->
    <script is:inline src="/theme.js"></script>
    <link rel="sitemap" href="/sitemap-index.xml" />
    <SEO
      {locale}
      {title}
      {description}
      {routeKey}
      {entrySlug}
      {image}
      {type}
      {noindex}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">{t(locale, 'a11y.skip')}</a>
    <Header {locale} current={routeKey} {entrySlug} />
    <main id="main">
      <slot />
    </main>
    <Footer {locale} />
  </body>
</html>
