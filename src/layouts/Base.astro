---
/**
 * Base layout — the only place that owns the document skeleton:
 * <head>, skip link, header, <main> and footer.
 */
// One serif + one non-serif, and only those: Fraunces (display) +
// Space Grotesk (body/UI). wght-only for the sans; Fraunces keeps its
// character axes (standard) for the display type.
import frauncesWoff2 from '@fontsource-variable/fraunces/files/fraunces-latin-standard-normal.woff2';
import '@fontsource-variable/fraunces/standard.css';
import spaceGroteskWoff2 from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2';
import '@fontsource-variable/space-grotesk/wght.css';
import '../styles/tokens.css';
import '../styles/global.css';

import type { Locale } from '../config/site';
import { asset, type RouteKey } from '../i18n/routes';
import { htmlLang, t } from '../i18n';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  routeKey: RouteKey;
  entrySlug?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const { locale, title, description, routeKey, entrySlug, image, type, noindex } = Astro.props;
---

<!doctype html>
<html lang={htmlLang(locale)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#12151b" media="(prefers-color-scheme: dark)" />
    <!-- the two Latin faces the page paints text with: fetch them in
         parallel with the CSS instead of after it parses -->
    <link rel="preload" href={frauncesWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={spaceGroteskWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <!-- Theme bootstrap: the one documented progressive enhancement (AGENTS.md).
         Applies a pinned light/dark scheme before first paint; without JS the
         OS preference decides. -->
    <script is:inline src={asset('theme.js')}></script>
    <script is:inline src={asset('robot.js')}></script>
    <link rel="sitemap" href={asset('sitemap-index.xml')} />
    <SEO
      {locale}
      {title}
      {description}
      {routeKey}
      {entrySlug}
      {image}
      {type}
      {noindex}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">{t(locale, 'a11y.skip')}</a>
    <Header {locale} current={routeKey} {entrySlug} />
    <main id="main">
      <slot />
    </main>
    <Footer {locale} />
  </body>
</html>
