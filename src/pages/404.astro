---
/**
 * 404 — served by the host for any unknown path.
 * Neutral page (pt primary + links to the other locales), never indexed.
 */
import { LOCALES } from '../config/site';
import { t } from '../i18n';
import { href } from '../i18n/routes';
import { LOCALE_LABELS, HTML_LANG } from '../config/site';
import Base from '../layouts/Base.astro';

const locale = 'pt' as const;
---

<Base
  {locale}
  title={t(locale, 'notFound.title')}
  description={t(locale, 'notFound.body')}
  routeKey="home"
  noindex
>
  <div class="container page">
    <p class="eyebrow">404</p>
    <h1>{t(locale, 'notFound.title')}</h1>
    <p class="lead">{t(locale, 'notFound.body')}</p>
    <p class="actions">
      <a class="button" href={href(locale, 'home')}>{t(locale, 'notFound.home')}</a>
    </p>
    <ul class="langs">
      {
        LOCALES.map((l) => (
          <li>
            <a href={href(l, 'home')} lang={HTML_LANG[l]} hreflang={l}>
              {LOCALE_LABELS[l]}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .page {
    padding-block: var(--space-2xl);
  }

  .actions {
    margin-top: var(--space-m);
  }

  .langs {
    display: flex;
    gap: var(--space-s);
    padding: 0;
    margin: var(--space-l) 0 0;
    list-style: none;
    font-size: var(--step--1);
  }
</style>
