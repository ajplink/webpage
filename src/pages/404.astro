---
/**
 * 404 — served by the host for any unknown path. Shows the message in BOTH
 * languages at once (a 404 can't know which locale was requested), each with
 * a door home. Never indexed.
 */
import { LOCALES, HTML_LANG, type Locale } from '../config/site';
import { t } from '../i18n';
import { href } from '../i18n/routes';
import Base from '../layouts/Base.astro';

const locale = LOCALES[0];
---

<Base
  {locale}
  title={t(locale, 'notFound.title')}
  description={t(locale, 'notFound.body')}
  routeKey="home"
  noindex
>
  <div class="container page">
    <p class="code">404</p>
    <div class="langs">
      {
        LOCALES.map((l: Locale) => (
          <section class="lang" lang={HTML_LANG[l]}>
            <h1>{t(l, 'notFound.title')}</h1>
            <p class="lead">{t(l, 'notFound.body')}</p>
            <p>
              <a class="button" href={href(l, 'home')}>
                {t(l, 'notFound.home')}
              </a>
            </p>
          </section>
        ))
      }
    </div>
  </div>
</Base>

<style>
  .page {
    padding-block: var(--space-2xl);
  }

  .code {
    font-family: var(--font-sans);
    font-size: var(--step-2);
    color: var(--color-accent);
  }

  .langs {
    display: grid;
    gap: var(--space-xl);
    grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
    margin-top: var(--space-l);
  }

  .lang h1 {
    font-size: var(--step-3);
  }

  .lang .lead {
    margin-block: var(--space-s) var(--space-m);
    color: var(--color-text-muted);
  }
</style>
