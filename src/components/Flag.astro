---
/**
 * Flag — small vector flag for a locale (language dropdown).
 *
 * Exception to the "no hard-coded colours" rule (like the favicon): flag
 * colours are vexillological constants, not themeable design values.
 * Wrapped in a rounded, clipped span so the corners match the UI.
 */
import type { Locale } from '../config/site';

interface Props {
  locale: Locale;
  width?: number;
}

const { locale, width = 22 } = Astro.props;
const height = Math.round((width / 24) * 17);
---

<span class="flag" style={`width:${width}px;height:${height}px`}>
  {
    locale === 'pt' && (
      <svg viewBox="0 0 24 17" width={width} height={height} aria-hidden="true">
        <rect width="9.6" height="17" fill="#046a38" />
        <rect x="9.6" width="14.4" height="17" fill="#da291c" />
        <circle cx="9.6" cy="8.5" r="3.9" fill="none" stroke="#ffcc00" stroke-width="1.4" />
        <circle cx="9.6" cy="8.5" r="1.3" fill="none" stroke="#ffcc00" stroke-width="0.9" />
        <path d="M9.6 4.6v7.8M5.7 8.5h7.8" stroke="#ffcc00" stroke-width="0.8" />
      </svg>
    )
  }
  {
    locale === 'en-gb' && (
      <svg viewBox="0 0 24 17" width={width} height={height} aria-hidden="true">
        <rect width="24" height="17" fill="#012169" />
        <path d="M0 0l24 17M24 0L0 17" stroke="#fff" stroke-width="3.4" />
        <path d="M0 0l24 17M24 0L0 17" stroke="#c8102e" stroke-width="1.8" />
        <path d="M12 0v17M0 8.5h24" stroke="#fff" stroke-width="5.4" />
        <path d="M12 0v17M0 8.5h24" stroke="#c8102e" stroke-width="3" />
      </svg>
    )
  }
</span>

<style>
  .flag {
    display: inline-block;
    overflow: hidden;
    vertical-align: middle;
    border-radius: 4px;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-text) 18%, transparent);
    flex: none;
  }

  .flag svg {
    display: block;
  }
</style>
