---
/**
 * LanguageSwitch — segmented control: both languages visible at once, the
 * current one filled. Two links, one click, no menu — still zero JavaScript,
 * keyboard accessible, and the same control in the mobile nav panel.
 *
 * Alternatives considered (see TODO.md): a dropdown with full language
 * names and bigger flags, or a globe + code pill with a menu behind it.
 */
import { LOCALES, LOCALE_LABELS, HTML_LANG, type Locale } from '../config/site';
import { alternates, type RouteKey } from '../i18n/routes';
import { t } from '../i18n';
import Flag from './Flag.astro';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
  entrySlug?: string;
}

const { locale, routeKey, entrySlug } = Astro.props;
const alt = alternates(routeKey, entrySlug);
---

<div class="lang" role="group" aria-label={t(locale, 'a11y.language')}>
  <ul>
    {
      LOCALES.map((l) => (
        <li>
          <a
            href={alt[l]}
            lang={HTML_LANG[l]}
            hreflang={l}
            aria-current={l === locale ? 'true' : undefined}
          >
            <Flag locale={l} width={18} />
            <span>{LOCALE_LABELS[l]}</span>
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .lang {
    display: inline-flex;
    line-height: 1.2;
    font-size: var(--step--1);
  }

  .lang ul {
    display: flex;
    line-height: 1.2;
    padding: var(--space-3xs);
    margin: 0;
    list-style: none;
    background-color: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-pill);
  }

  .lang li {
    list-style: none;
  }

  .lang a {
    display: inline-flex;
    gap: var(--space-3xs);
    align-items: center;
    padding: var(--space-3xs) var(--space-2xs);
    font-size: var(--step--1);
    font-weight: 650;
    color: var(--color-text-muted);
    text-decoration: none;
    border-radius: var(--radius-pill);
    transition:
      color var(--duration) var(--ease),
      background-color var(--duration) var(--ease);
  }

  .lang a:hover {
    color: var(--color-text);
    background-color: var(--color-tint);
  }

  /* the current language is a filled chip — the page background on ink */
  .lang a[aria-current='true'] {
    color: var(--color-bg);
    background-color: var(--color-text);
  }
</style>
