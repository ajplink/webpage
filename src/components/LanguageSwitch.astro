---
/**
 * LanguageSwitch — flag dropdown linking to the same page in other locales.
 * CSS-only (`<details>`), keyboard accessible, zero JavaScript. Every locale
 * always exists for every route (content may fall back), so every entry is a
 * real, working link. The trigger is borderless; the panel keeps the site's
 * hairline border.
 */
import { LOCALES, LOCALE_LABELS, HTML_LANG, type Locale } from '../config/site';
import { alternates, type RouteKey } from '../i18n/routes';
import { t } from '../i18n';
import Flag from './Flag.astro';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
  entrySlug?: string;
}

const { locale, routeKey, entrySlug } = Astro.props;
const alt = alternates(routeKey, entrySlug);
---

<details class="lang">
  <summary aria-label={t(locale, 'a11y.language')}>
    <Flag {locale} width={18} />
    <span class="lang-label">{LOCALE_LABELS[locale]}</span>
    <Icon name="chevron" size={14} />
  </summary>
  <ul>
    {
      LOCALES.map((l) => (
        <li>
          <a
            href={alt[l]}
            lang={HTML_LANG[l]}
            hreflang={l}
            aria-current={l === locale ? 'true' : undefined}
          >
            <Flag locale={l} width={18} />
            <span>{LOCALE_LABELS[l]}</span>
          </a>
        </li>
      ))
    }
  </ul>
</details>

<style>
  .lang {
    position: relative;
    font-size: var(--step--1);
  }

  .lang summary {
    display: inline-flex;
    gap: var(--space-3xs);
    align-items: center;
    padding: var(--space-3xs) var(--space-2xs);
    font-weight: 600;
    color: var(--color-text);
    cursor: pointer;
    list-style: none;
    border-radius: var(--radius-pill);
    transition: background-color var(--duration) var(--ease);
  }

  .lang summary::-webkit-details-marker {
    display: none;
  }

  .lang summary:hover {
    background-color: var(--color-tint);
  }

  .lang summary :global(svg:last-child) {
    color: var(--color-text-muted);
    transition: transform var(--duration) var(--ease);
  }

  .lang[open] summary :global(svg:last-child) {
    transform: rotate(180deg);
  }

  .lang ul {
    position: absolute;
    right: 0;
    z-index: 6;
    min-width: 9rem;
    padding: var(--space-3xs);
    margin-top: var(--space-3xs);
    list-style: none;
    background-color: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius);
    transform-origin: top right;
    animation: lang-pop var(--duration) var(--ease) both;
  }

  @keyframes lang-pop {
    from {
      opacity: 0;
      transform: translateY(-0.3rem);
    }
  }

  .lang a {
    display: flex;
    gap: var(--space-2xs);
    align-items: center;
    padding: var(--space-2xs);
    color: var(--color-text);
    text-decoration: none;
    border-radius: var(--radius-s);
  }

  .lang a:hover {
    background-color: var(--color-tint);
  }

  .lang a[aria-current='true'] {
    color: var(--color-primary);
    background-color: var(--color-tint);
  }
</style>
