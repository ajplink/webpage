---
/**
 * LanguageSwitch — links to the same page in the other locales.
 * All three locales always exist for every route (content may fall back),
 * so every switcher entry is a real, working link.
 */
import { LOCALES, LOCALE_LABELS, HTML_LANG, type Locale } from '../config/site';
import { alternates, type RouteKey } from '../i18n/routes';
import { t } from '../i18n';

interface Props {
  locale: Locale;
  routeKey: RouteKey;
  entrySlug?: string;
}

const { locale, routeKey, entrySlug } = Astro.props;
const alt = alternates(routeKey, entrySlug);
---

<div class="langswitch">
  <ul aria-label={t(locale, 'a11y.language')}>
    {
      LOCALES.map((l) => (
        <li>
          <a
            href={alt[l]}
            lang={HTML_LANG[l]}
            hreflang={l}
            aria-current={l === locale ? 'true' : undefined}
          >
            {LOCALE_LABELS[l]}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .langswitch ul {
    display: flex;
    gap: var(--space-2xs);
    align-items: center;
    padding: 0;
    margin: 0;
    list-style: none;
    font-size: var(--step--1);
  }

  .langswitch a {
    padding: var(--space-3xs) var(--space-2xs);
    color: var(--color-text-muted);
    text-decoration: none;
    border-radius: var(--radius);
  }

  .langswitch a:hover {
    color: var(--color-primary);
    background-color: var(--color-tint);
  }

  .langswitch a[aria-current='true'] {
    font-weight: 700;
    color: var(--color-text);
    box-shadow: inset 0 -2px 0 0 var(--color-accent);
  }
</style>
