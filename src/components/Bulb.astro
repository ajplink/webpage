---
/**
 * Bulb — the association's mark: Ricardo's lightbulb artwork (lampada.svg,
 * served from /public so it is fetched once and cached). Decorative: the
 * surrounding text always carries the name.
 */
interface Props {
  size?: number;
  class?: string;
  /** Eager-load (above the fold) or lazy. */
  eager?: boolean;
}

const { size = 28, class: className, eager = false } = Astro.props;
---

<img
  class:list={['bulb', className]}
  src="/lampada.svg"
  width={size}
  height={size}
  alt=""
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
/>

<style>
  .bulb {
    display: block;
    flex: none;
  }
</style>
