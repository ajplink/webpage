---
/**
 * Bulb — the association's mascot: Ricardo's lightbulb, redrawn as clean
 * vector art (hand-authored shapes, not a trace). The theme switch too:
 * clicking it turns the light ON (light mode) and OFF (dark mode).
 *
 * Colours: the mascot's yellow (#fff570) and ink. The favicon is no longer
 * this mark: it is the wordmark's three strokes (public/favicon.svg).
 */
interface Props {
  size?: number;
  class?: string;
  /** Standalone decorative mark (footer, about header) — always lit. */
  plain?: boolean;
}

const { size = 40, class: className, plain = false } = Astro.props;
---

<svg
  class:list={['bulb', plain && 'bulb--plain', className]}
  viewBox="0 0 140 244"
  width={size}
  height={Math.round((size / 140) * 244)}
  aria-hidden="true"
  focusable="false"
>
  <!-- the light: a soft halo and short rays, only when it is on -->
  <g class="bulb-glow">
    <circle cx="70" cy="86" r="62" fill="var(--palette-yellow)" opacity="0.16"></circle>
    <g stroke="var(--palette-yellow)" stroke-width="7" stroke-linecap="round">
      <path d="M70 8v14"></path>
      <path d="M22 24l10 11"></path>
      <path d="M118 24l-10 11"></path>
      <path d="M6 82h13"></path>
      <path d="M121 82h13"></path>
    </g>
  </g>

  <!-- the glass -->
  <path
    class="bulb-glass"
    d="M70 30c-26 0-46 20-46 45 0 17 8 28 17 37 6 6 9 11 10 17h38c1-6 4-11 10-17 9-9 17-20 17-37 0-25-20-45-46-45z"
    fill="#fff570"
    stroke="#141414"
    stroke-width="8"
    stroke-linejoin="round"></path>

  <!-- the shine -->
  <path d="M42 58c3-11 12-19 23-21-9 6-14 13-16 23-2 8-7 9-7-2z" fill="#fffbc3"></path>

  <!-- the filament: a small heart, because of course -->
  <path
    d="M70 92c-8-7-16-11-16-19 0-5 4-8 8-8 3 0 6 2 8 5 2-3 5-5 8-5 4 0 8 3 8 8 0 8-8 12-16 19z"
    fill="none"
    stroke="#141414"
    stroke-width="5.5"
    stroke-linejoin="round"></path>

  <!-- the neck -->
  <rect x="44" y="124" width="52" height="15" rx="7.5" fill="#141414"></rect>

  <!-- the screw base -->
  <path d="M50 139h40v30c0 8-6 14-14 14h-12c-8 0-14-6-14-14z" fill="#141414"></path>
  <path
    d="M55 150c4 2 8 2 12 0s8-2 12 0M55 162c4 2 8 2 12 0s8-2 12 0"
    fill="none"
    stroke="#fff570"
    stroke-width="5"
    stroke-linecap="round"></path>

  <!-- the tip -->
  <path d="M58 183h24c5 0 9 4 9 9v4c0 6-5 10-11 10h-20c-6 0-11-4-11-10v-4c0-5 4-9 9-9z" fill="#141414"
  ></path>
</svg>

<style>
  .bulb-glass {
    transition: fill var(--duration-slow) var(--ease);
  }

  .bulb-glow {
    opacity: 1;
    transition: opacity var(--duration-slow) var(--ease);
    transform-box: fill-box;
    transform-origin: center;
  }

  /* light OFF (dark mode): a resting bulb */
  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme='light'])) .bulb-glow {
      opacity: 0;
    }

    :global(html:not([data-theme='light'])) .bulb-glass {
      fill: #55503f;
    }
  }

  :global(html[data-theme='dark']) .bulb-glow {
    opacity: 0;
  }

  :global(html[data-theme='dark']) .bulb-glass {
    fill: #55503f;
  }
</style>
