---
/**
 * Bulb — the association's mascot: the lightbulb from Ricardo's mascote.png,
 * redrawn as clean vector art (hand-authored paths, not a trace). Also the
 * theme switch: the bulb turns the light on (light mode) and off (dark mode).
 *
 * Colours: the mascot's yellow (#fff570) and ink; the favicon mirrors this
 * file (favicon exception — kept in sync by hand).
 */
interface Props {
  size?: number;
  class?: string;
  /** Standalone decorative mark (footer etc.) — not interactive. */
  plain?: boolean;
}

const { size = 40, class: className, plain = false } = Astro.props;
---

<svg
  class:list={['bulb', plain && 'bulb--plain', className]}
  viewBox="0 0 120 232"
  width={size}
  height={Math.round((size / 120) * 232)}
  aria-hidden="true"
  focusable="false"
>
  <!-- the glow, only when the light is on -->
  <g class="bulb-glow">
    <path d="M60 2v12M18 18l8 9M102 18l-8 9M4 74h12M104 74h12" stroke="#fed10d"
      stroke-width="7" stroke-linecap="round"></path>
  </g>

  <!-- the glass -->
  <path
    class="bulb-glass"
    d="M60 22c-27 0-49 21-49 47 0 18 9 30 18 40 6 7 9 12 10 19h42c1-7 4-12 10-19 9-10 18-22 18-40 0-26-22-47-49-47z"
    fill="#fff570"
    stroke="#111111"
    stroke-width="8"
    stroke-linejoin="round"></path>

  <!-- the filament -->
  <path
    d="M43 74c4-6 8 3 12-2s8 3 12-2 8 3 12-2"
    fill="none"
    stroke="#111111"
    stroke-width="5"
    stroke-linecap="round"></path>

  <!-- the collar -->
  <rect x="32" y="126" width="56" height="16" rx="8" fill="#111111"></rect>

  <!-- the screw base -->
  <path d="M38 142h44v34c0 8-6 14-14 14H52c-8 0-14-6-14-14z" fill="#111111"></path>
  <path d="M42 152h36M42 164h30" stroke="#fff570" stroke-width="5" stroke-linecap="round"></path>

  <!-- the tip -->
  <path d="M50 190h20c4 0 7 3 7 7v6c0 5-4 9-9 9h-16c-5 0-9-4-9-9v-6c0-4 3-7 7-7z" fill="#111111"
  ></path>
</svg>

<style>
  .bulb-glass {
    transition: fill var(--duration-slow) var(--ease);
  }

  .bulb-glow {
    opacity: 0;
    transition: opacity var(--duration-slow) var(--ease);
  }

  /* light on (light mode): a warm, glowing bulb */
  :global(html:not([data-theme='dark'])) .bulb-glow,
  :global(html[data-theme='light']) .bulb-glow {
    opacity: 1;
  }

  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme='light'])) .bulb-glow {
      opacity: 0;
    }

    :global(html:not([data-theme='light'])) .bulb-glass {
      fill: #4a4536;
    }
  }

  /* light off (dark mode): a resting bulb */
  :global(html[data-theme='dark']) .bulb-glass {
    fill: #4a4536;
  }

  .bulb--plain .bulb-glow {
    opacity: 1;
  }
</style>
