---
/**
 * Footer — small and horizontal: mark + name, links in one row, social as
 * icons. No marketing line, no stacking columns.
 */
import { SITE, type Locale } from '../config/site';
import { href } from '../i18n/routes';
import { t } from '../i18n';
import Logo from './Logo.astro';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();

/** Icon per social network (Icon.astro glyphs). */
const SOCIAL_ICON = { Instagram: 'instagram', LinkedIn: 'linkedin' } as const;
---

<footer class="footer">
  <div class="container footer-row">
    <a class="footer-brand" href={href(locale, 'home')} aria-label={SITE.name}>
      <Logo width={110} />
    </a>

    <nav aria-label={t(locale, 'a11y.footerNav')}>
      <ul class="footer-links">
        <li><a href={href(locale, 'join')}>{t(locale, 'nav.join')}</a></li>
        <li><a href={href(locale, 'members')}>{t(locale, 'nav.members')}</a></li>
        <li><a href={href(locale, 'donations')}>{t(locale, 'nav.donations')}</a></li>
        <li><a href={href(locale, 'sponsors')}>{t(locale, 'nav.sponsors')}</a></li>
        <li><a href={href(locale, 'privacy')}>{t(locale, 'nav.privacy')}</a></li>
        <li><a href={`mailto:${SITE.contactEmail}`}>{t(locale, 'join.emailLabel')}</a></li>
      </ul>
    </nav>

    <ul class="footer-social">
      {
        SITE.social.map((item) => (
          <li>
            <a href={item.url} rel="me noopener" aria-label={item.label}>
              <Icon name={SOCIAL_ICON[item.label as keyof typeof SOCIAL_ICON]} size={20} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="container footer-legal">
    <p>© {year} {SITE.legalName} · {SITE.legalId}</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-2xl);
    padding-block: var(--space-m);
    font-size: var(--step--1);
    color: var(--color-text-muted);
    border-top: var(--border-width) solid var(--color-border);
  }

  .footer-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s) var(--space-l);
    align-items: center;
    justify-content: space-between;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    color: var(--color-text);
    text-decoration: none;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-s);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .footer a {
    color: var(--color-text-muted);
  }

  .footer a:hover {
    color: var(--color-primary);
  }

  .footer-social {
    display: flex;
    gap: var(--space-2xs);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .footer-social a {
    display: grid;
    place-items: center;
    padding: var(--space-3xs);
    border-radius: var(--radius-pill);
  }

  .footer-social a:hover {
    background-color: var(--color-tint);
  }

  .footer-legal {
    margin-top: var(--space-s);
    font-size: var(--step--1);
  }
</style>
