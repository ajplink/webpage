---
/**
 * Footer — secondary navigation, contact, social links and legal line.
 */
import { SITE, type Locale } from '../config/site';
import { href } from '../i18n/routes';
import { t } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <p class="brand-name">{SITE.name}</p>
      <p class="tagline">{SITE.tagline[locale]}</p>
    </div>

    <nav aria-label={t(locale, 'a11y.footerNav')}>
      <ul>
        <li><a href={href(locale, 'join')}>{t(locale, 'nav.join')}</a></li>
        <li><a href={href(locale, 'privacy')}>{t(locale, 'nav.privacy')}</a></li>
        <li><a href={`mailto:${SITE.contactEmail}`}>{t(locale, 'join.emailLabel')}</a></li>
      </ul>
    </nav>

    <ul class="footer-social">
      {
        SITE.social.map((item) => (
          <li>
            <a href={item.url} rel="me noopener">{item.label}</a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="container footer-legal">
    <p>
      © {year} {SITE.legalName} · {SITE.legalId}
    </p>
    <p class="footer-note">{SITE.footerText[locale]}</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-2xl);
    padding-block: var(--space-l);
    font-size: var(--step--1);
    color: var(--color-text-muted);
    border-top: var(--border-width) solid var(--color-border);
  }

  .footer-grid {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
    align-items: start;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: 600;
    color: var(--color-text);
  }

  .tagline {
    max-width: 32ch;
    margin-top: var(--space-3xs);
  }

  .footer nav ul,
  .footer-social {
    display: grid;
    gap: var(--space-3xs);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .footer a {
    color: var(--color-text-muted);
  }

  .footer a:hover {
    color: var(--color-primary);
  }

  .footer-legal {
    margin-top: var(--space-l);
    padding-top: var(--space-s);
    border-top: var(--border-width) solid var(--color-border);
  }

  .footer-note {
    max-width: var(--measure);
    margin-top: var(--space-3xs);
  }
</style>
