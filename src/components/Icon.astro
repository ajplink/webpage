---
/**
 * Icon — the site's icon set (inline SVG, stroke style).
 *
 * The shapes live in src/lib/icons.ts: one 24×24 grid, 2-unit strokes, round
 * caps and joins — the same file feeds the About page's cradle, so glyphs are
 * identical everywhere. Add new ones there, never as raster or emoji.
 *
 * `--icon-fill` lets a caller paint a glyph's interior (the theme bulb lights
 * up that way); by default every icon is stroke-only.
 */
import { ICON_PATHS, type IconName } from '../lib/icons';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className } = Astro.props;
---

<svg
  class:list={['icon', className]}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  aria-hidden="true"
  focusable="false"
>
  <g
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d={ICON_PATHS[name]} />
  </g>
</svg>

<style>
  .icon {
    display: inline-block;
    flex: none;
    vertical-align: middle;
  }

  .icon g {
    fill: var(--icon-fill, none);
  }
</style>
