---
/**
 * Hero — the mission line beside the one-stroke "plink" wordmark, which
 * writes itself in front of the user (the one orchestrated motion moment).
 * The wordmark is placeholder letterforms until Ricardo's SVG lands.
 */
import Logo from './Logo.astro';

interface Props {
  eyebrow: string;
  title: string;
  lead: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-text">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="lead">{lead}</p>
      <div class="hero-actions">
        <slot />
      </div>
    </div>

    <div class="hero-mark">
      <Logo animate width={400} />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-xl) var(--space-l);
  }

  .hero-grid {
    display: grid;
    gap: var(--space-l);
    align-items: center;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
  }

  .hero-text h1 {
    margin-top: var(--space-2xs);
    font-size: var(--step-5);
    color: var(--color-text);
  }

  .hero-text .lead {
    margin-top: var(--space-s);
    color: var(--color-text-muted);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    align-items: center;
    margin-top: var(--space-m);
  }

  .hero-mark {
    justify-self: end;
    width: min(100%, 26rem);
    padding: var(--space-s);
  }

  @media (max-width: 40rem) {
    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-mark {
      width: min(100%, 18rem);
      justify-self: start;
    }
  }
</style>
