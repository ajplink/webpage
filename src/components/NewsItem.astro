---
/**
 * NewsItem — one news post in a list: date, title, summary, topic tags.
 */
import type { Locale } from '../config/site';
import type { LocalizedEntry } from '../lib/content';
import { formatDate, t } from '../i18n';
import { href } from '../i18n/routes';
import Card from './Card.astro';
import Tag from './Tag.astro';

interface Props {
  locale: Locale;
  item: LocalizedEntry<'news'>;
}

const { locale, item } = Astro.props;
const { title, summary, date, tags } = item.data;
---

<Card as="li">
  <p class="date">
    <time datetime={date.toISOString().slice(0, 10)}>{formatDate(locale, date)}</time>
  </p>
  <h3 class="title">
    <a href={href(locale, 'news', item.slug)}>{title}</a>
  </h3>
  <p class="summary">{summary}</p>
  {
    tags.length > 0 && (
      <ul class="tags" aria-label={t(locale, 'news.tags')}>
        {tags.map((tag) => (
          <li>
            <Tag label={tag} />
          </li>
        ))}
      </ul>
    )
  }
</Card>

<style>
  .date {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }

  .title {
    font-size: var(--step-1);
  }

  .title a {
    color: var(--color-text);
    text-decoration: none;
  }

  .title a:hover {
    color: var(--color-primary);
  }

  .summary {
    font-size: var(--step--1);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    padding: 0;
    margin: auto 0 0;
    list-style: none;
  }
</style>
