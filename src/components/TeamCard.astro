---
/**
 * TeamCard — person card in the department carousel: big portrait (dummy
 * SVG portrait while the real photos are missing), name, role, bio, links.
 */
import { Image } from 'astro:assets';
import type { LocalizedEntry } from '../lib/content';
import Card from './Card.astro';

interface Props {
  member: LocalizedEntry<'team'>;
  /** Marquee clone of another card: hidden from assistive tech. */
  clone?: boolean;
}

const { member, clone } = Astro.props;
const { name, role, bio, photo, links } = member.data;

/** Initials fallback when no portrait exists (never invent photos). */
const initials = name
  .split(/\s+/)
  .filter((word) => word.length > 1)
  .slice(0, 2)
  .map((word) => word[0])
  .join('')
  .toUpperCase();
---

<Card as="li" ariaHidden={clone}>
  {
    photo ? (
      <Image
        class="portrait"
        src={photo}
        alt=""
        width={480}
        height={480}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <span class="portrait initials" aria-hidden="true">
        {initials}
      </span>
    )
  }
  <h3 class="name">{name}</h3>
  <p class="role">{role}</p>
  <p class="bio">{bio}</p>
  {
    links && links.length > 0 && (
      <ul class="links">
        {links.map((link) => (
          <li>
            <a href={link.url} rel="me noopener">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</Card>

<style>
  .portrait {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius);
  }

  .initials {
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: var(--step-3);
    color: var(--color-primary);
    background-color: var(--color-tint);
    border: var(--border-width) solid var(--color-border);
  }

  .name {
    margin-top: var(--space-2xs);
    font-size: var(--step-1);
  }

  .role {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--color-accent);
  }

  .bio {
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    padding: 0;
    margin: auto 0 0;
    list-style: none;
    font-size: var(--step--1);
  }
</style>
