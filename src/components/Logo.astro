{
  animate && import.meta.env.DEV && (
    <div class="scrub">
      <label for="word-scrub">trace the writing</label>
      <input id="word-scrub" type="range" min="0" max="100" value="0" data-word-scrub />
    </div>
  )
}

{
  animate && import.meta.env.DEV && (
    <script is:inline>
      // dev-only scrubber: drag to trace the writing path frame by frame
      (() => {
        const init = () => {
          const range = document.querySelector('[data-word-scrub]');
          const svg = document.querySelector('.wordmark--draw');
          if (!range || !svg) return;
          const pen = svg.querySelector('.wordmark-pen');
          const settle = svg.querySelector('.wordmark-settle');
          const sparks = svg.querySelector('.wordmark-sparks');
          range.addEventListener('input', () => {
            const p = range.value / 100;
            for (const el of [pen, settle, sparks]) if (el) el.style.animation = 'none';
            for (const path of document.querySelectorAll('.wordmark-pen')) {
              const s = +path.dataset.start, e = +path.dataset.end;
              const local = Math.min(1, Math.max(0, (p - s) / (e - s)));
              path.style.strokeDashoffset = String((1 - local) * 1000);
            }
            settle.style.opacity = p >= 0.95 ? '1' : '0';
            sparks.style.opacity = p >= 0.9 ? '1' : '0';
            sparks.style.transform = 'none';
          });
        };
        document.readyState === 'loading'
          ? document.addEventListener('DOMContentLoaded', init)
          : init();
      })();
    </script>
  )
}

<style>
  .scrub {
    display: flex;
    gap: var(--space-2xs);
    align-items: center;
    margin-top: var(--space-2xs);
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }

  .scrub input {
    flex: 1;
    accent-color: var(--color-accent);
  }
</style>

<style>
  .wordmark {
    display: block;
    height: auto;
    overflow: visible;
  }

  .logo-ink {
    fill: var(--logo-ink);
  }

  .logo-spark {
    fill: var(--logo-spark);
  }

  .pen-route {
    fill: none;
  }

  /* Static default = the finished word. The animation only replays it. */
  .wordmark-pen {
    stroke-dasharray: 1000;
    stroke-dashoffset: 0;
    animation: write calc(var(--draw-duration) * var(--w-len)) var(--ease) both;
    animation-delay: calc(var(--draw-duration) * var(--w-start));
  }

  @keyframes write {
    from {
      stroke-dashoffset: 1000;
    }
  }

  /* any missed speck settles in during the last beat */
  .wordmark-settle {
    opacity: 0;
  }

  .wordmark--draw .wordmark-settle {
    animation: settle calc(var(--draw-duration) * 0.18) linear both;
    animation-delay: calc(var(--draw-duration) * 0.95);
  }

  @keyframes settle {
    to {
      opacity: 1;
    }
  }




  /* the three sparks blink in when the word is done */
  .wordmark-sparks {
    transform-box: fill-box;
    transform-origin: center;
  }

  .wordmark--draw .wordmark-sparks {
    animation: spark-blink calc(var(--draw-duration) * 0.32) var(--ease) both;
    animation-delay: calc(var(--draw-duration) * 0.88);
  }

  @keyframes spark-blink {
    0% {
      opacity: 0;
      transform: scale(0.5);
    }

    35% {
      opacity: 1;
      transform: scale(1.15);
    }

    55% {
      opacity: 0.25;
      transform: scale(1);
    }

    75% {
      opacity: 1;
      transform: scale(1.06);
    }

    88% {
      opacity: 0.55;
      transform: scale(1);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Reduced motion: no writing, no blink, no tip — the finished word. */
  @media (prefers-reduced-motion: reduce) {
    .wordmark--draw .wordmark-pen,
    .wordmark--draw .wordmark-sparks {
      animation: none;
    }

  }
</style>
