  animate && import.meta.env.DEV && (
    <div class="scrub">
      <label for="word-scrub">trace the writing</label>
      <input id="word-scrub" type="range" min="0" max="100" value="0" data-word-scrub />
    </div>
  )
}

{
  animate && import.meta.env.DEV && (
    <script is:inline>
      // dev-only scrubber: drag to trace the writing path frame by frame
      (() => {
        const init = () => {
          const range = document.querySelector('[data-word-scrub]');
          const svg = document.querySelector('.wordmark--draw');
          if (!range || !svg) return;
          const pen = svg.querySelector('.wordmark-pen');
          const nib = svg.querySelector('.wordmark-nib');
          const settle = svg.querySelector('.wordmark-settle');
          const sparks = svg.querySelector('.wordmark-sparks');
          range.addEventListener('input', () => {
            const p = range.value / 100;
            for (const el of [pen, nib, settle, sparks]) if (el) el.style.animation = 'none';
            pen.style.strokeDashoffset = String((1 - p) * 1000);
            nib.style.strokeDashoffset = String(-p * 1000);
            nib.style.opacity = p > 0.01 && p < 0.99 ? '1' : '0';
            settle.style.opacity = p >= 0.92 ? '1' : '0';
            sparks.style.opacity = p >= 0.9 ? '1' : '0';
            sparks.style.transform = 'none';
          });
        };
        document.readyState === 'loading'
          ? document.addEventListener('DOMContentLoaded', init)
          : init();
      })();
    </script>
  )
}

<style>
  .scrub {
    display: flex;
    gap: var(--space-2xs);
    align-items: center;
    margin-top: var(--space-2xs);
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }

  .scrub input {
    flex: 1;
    accent-color: var(--color-accent);
  }
</style>

<style>
  .wordmark {
    display: block;
    height: auto;
    overflow: visible;
  }

  .logo-ink {
    fill: var(--logo-ink);
  }

  .logo-spark {
    fill: var(--logo-spark);
  }

  .pen-route {
    fill: none;
  }

  /* Static default = the finished word. The animation only replays it. */
  .wordmark-pen {
    stroke-dasharray: 1000;
    stroke-dashoffset: 0;
    animation: write var(--draw-duration) var(--ease) both;
  }

  @keyframes write {
    from {
      stroke-dashoffset: 1000;
    }
  }

  /* any missed speck settles in during the last beat */
  .wordmark-settle {
    opacity: 0;
  }

  .wordmark--draw .wordmark-settle {
    animation: settle calc(var(--draw-duration) * 0.18) linear both;
