---
/**
 * Logo — the "plink" wordmark (Ricardo's artwork, nome.svg: the ink word +
 * the three yellow sparks on the i).
 *
 * `animate` draws the word EXACTLY as it is written: one continuous path
 * (the skeleton of the artwork, derived by scripts/penpath.py) sweeps like a
 * pen and the ink appears behind it; the marker tip rides the same path;
 * the three sparks blink in when the word lands. CSS-only, once per page
 * load; prefers-reduced-motion sees the finished word immediately.
 */
interface Props {
  /** Draw the wordmark in front of the user (hero moment). */
  animate?: boolean;
  /** Rendered width in px (height follows the viewBox ratio). */
  width?: number;
  class?: string;
}

const { animate = false, width = 180, class: className } = Astro.props;
const height = Math.round((width / 3083) * 1503);
---

