---
/**
 * ThemeToggle — a light switch for the site: flip it up for light mode,
 * down for dark. Hidden until /theme.js reveals it: without JavaScript the
 * OS preference decides the scheme (see AGENTS.md).
 */
import { t } from '../i18n';
import type { Locale } from '../config/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<button
  class="theme-toggle"
  type="button"
  data-theme-toggle
  data-label-light={t(locale, 'theme.toLight')}
  data-label-dark={t(locale, 'theme.toDark')}
  aria-label={t(locale, 'theme.toggle')}
  aria-pressed="false"
>
  <svg class="switch" viewBox="0 0 64 92" width="30" height="43" aria-hidden="true" focusable="false">
    <!-- the plate -->
    <rect x="6" y="4" width="52" height="84" rx="14" fill="var(--color-surface)"
      stroke="var(--color-text)" stroke-width="5"></rect>
    <!-- the rocker -->
    <rect x="17" y="16" width="30" height="60" rx="13" fill="var(--color-tint)"
      stroke="var(--color-text)" stroke-width="4"></rect>
    <!-- the knob: up = light on, down = light off -->
    <rect class="knob" x="21" y="21" width="22" height="24" rx="10" fill="#fff570"
      stroke="var(--color-text)" stroke-width="3.5"></rect>
    <!-- the little marks -->
    <path d="M32 70v5" stroke="var(--color-text)" stroke-width="3.5" stroke-linecap="round"></path>
    <circle cx="32" cy="25" r="0"></circle>
  </svg>
</button>

<style>
  .theme-toggle {
    display: none;
    padding: var(--space-3xs);
    cursor: pointer;
    background-color: transparent;
    border: var(--border-width) solid transparent;
    border-radius: var(--radius-s);
  }

  :global(html.js) .theme-toggle {
    display: inline-flex;
  }

  .theme-toggle:hover {
    border-color: var(--color-border);
  }

  .knob {
    transition: transform var(--duration-slow) var(--ease), fill var(--duration-slow) var(--ease);
  }

  /* light mode: the switch is up and the knob glows */
  :global(html[data-theme='light']) .knob,
  :global(html:not([data-theme='dark'])) .knob {
    transform: translateY(0);
    fill: #fff570;
  }

  /* dark mode: the switch is down and the knob rests */
  :global(html[data-theme='dark']) .knob,
  :global(html[data-theme='dark']) .switch .knob {
    transform: translateY(26px);
    fill: #55503f;
  }

  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme='light'])) .knob {
      transform: translateY(26px);
      fill: #55503f;
    }
  }
</style>
