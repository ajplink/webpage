---
/**
 * ThemeToggle — the mascot lightbulb turns the site's light ON (light mode)
 * and OFF (dark mode). Hidden until /theme.js reveals it: without JavaScript
 * the OS preference decides the scheme (see AGENTS.md).
 */
import { t } from '../i18n';
import type { Locale } from '../config/site';
import Bulb from './Bulb.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<button
  class="theme-toggle"
  type="button"
  data-theme-toggle
  data-label-light={t(locale, 'theme.toLight')}
  data-label-dark={t(locale, 'theme.toDark')}
  aria-label={t(locale, 'theme.toggle')}
  aria-pressed="false"
>
  <Bulb size={34} />
</button>

<style>
  .theme-toggle {
    display: none;
    padding: var(--space-3xs);
    cursor: pointer;
    background-color: transparent;
    border: var(--border-width) solid transparent;
    border-radius: var(--radius-pill);
  }

  :global(html.js) .theme-toggle {
    display: inline-flex;
  }

  .theme-toggle:hover {
    border-color: var(--color-border);
  }

  .theme-toggle:active {
    transform: scale(0.92);
  }
</style>
