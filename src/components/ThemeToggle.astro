---
/**
 * ThemeToggle — "acender / apagar": the association's bulb IS the switch.
 * Lit in light mode (yellow glass, soft glow), off in dark mode. Hidden until
 * /theme.js reveals it: without JavaScript the OS preference decides the
 * scheme (see AGENTS.md).
 *
 * Alternatives considered (see TODO.md): a sun/moon slider pill, a sun↔moon
 * morph icon, a physical rocker switch.
 */
import { t } from '../i18n';
import type { Locale } from '../config/site';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<button
  class="theme-toggle"
  type="button"
  data-theme-toggle
  data-label-light={t(locale, 'theme.toLight')}
  data-label-dark={t(locale, 'theme.toDark')}
  aria-label={t(locale, 'theme.toggle')}
  aria-pressed="false"
>
  <Icon name="bulb" size={28} />
</button>

<style>
  .theme-toggle {
    display: none;
    padding: var(--space-3xs) var(--space-2xs);
    font-size: var(--step--1);
    color: var(--color-text);
    cursor: pointer;
    background-color: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-pill);
    transition: border-color var(--duration) var(--ease);
  }

  :global(html.js) .theme-toggle {
    display: inline-flex;
    /* lights ON (light mode): a lit bulb with a soft glow */
    --icon-fill: var(--palette-yellow);
    --bulb-glow: drop-shadow(0 0 0.3rem color-mix(in srgb, var(--palette-yellow) 55%, transparent));
  }

  .theme-toggle:hover {
    border-color: color-mix(in srgb, var(--color-primary) 45%, var(--color-border));
  }

  .theme-toggle :global(.icon) {
    width: 1.8em;
    height: 1.8em;
    filter: var(--bulb-glow, none);
  }

  /* lights OFF (dark mode): a resting bulb, no glow */
  @media (prefers-color-scheme: dark) {
    :global(html:not([data-theme='light'])) .theme-toggle {
      --icon-fill: none;
      --bulb-glow: none;
      color: var(--color-text-muted);
    }
  }

  :global(html[data-theme='dark']) .theme-toggle {
    --icon-fill: none;
    --bulb-glow: none;
    color: var(--color-text-muted);
  }
</style>
