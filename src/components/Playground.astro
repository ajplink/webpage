---
/**
 * Playground — the Newton's cradle that sits next to the "what we do" text:
 * five pendulums carrying the association's values, with real impact
 * physics (drag a ball and let go). Vanilla canvas (/about-play.js).
 */
import type { Locale } from '../config/site';
import { t } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const values = [
  t(locale, 'play.valueDoing'),
  t(locale, 'play.valueAccess'),
  t(locale, 'play.valueOpen'),
  t(locale, 'play.valueCommunity'),
  t(locale, 'play.valueCuriosity'),
].join('|');
---

<figure class="cradle">
  <canvas data-cradle data-labels={values} height="380" role="img" aria-label={t(locale, 'play.cradle')}></canvas>
  <figcaption>
    <strong>{t(locale, 'play.cradle')}</strong>
    <span>{t(locale, 'play.cradleHint')}</span>
  </figcaption>
</figure>

<script is:inline src="/about-play.js"></script>

<style>
  .cradle {
    display: grid;
    gap: var(--space-2xs);
    position: sticky;
    top: var(--space-s);
  }

  canvas {
    width: 100%;
    height: 23rem;
    touch-action: none;
    background-color: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius);
    cursor: grab;
  }

  canvas:active {
    cursor: grabbing;
  }

  figcaption {
    display: grid;
    gap: var(--space-3xs);
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }

  figcaption strong {
    color: var(--color-text);
  }
</style>
