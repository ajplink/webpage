---
/**
 * Playground — the Newton's cradle next to the "what we do" text: five
 * pendulums carrying the association's values, each ball wearing its value's
 * glyph (the same shapes as the value cards below), with real impact physics
 * (drag a ball and let go). Vanilla canvas (/about-play.js), no card chrome:
 * the simulation sits straight on the page.
 */
import type { Locale } from '../config/site';
import { t } from '../i18n';
import { ICON_PATHS, type IconName } from '../lib/icons';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const values: { key: string; icon: IconName }[] = [
  { key: 'play.valueDoing', icon: 'rocket' },
  { key: 'play.valueAccess', icon: 'users' },
  { key: 'play.valueOpen', icon: 'book' },
  { key: 'play.valueCommunity', icon: 'heart' },
  { key: 'play.valueCuriosity', icon: 'spark' },
];

const labels = values.map((v) => t(locale, v.key as 'play.valueDoing'));
const glyphs = values.map((v) => ICON_PATHS[v.icon]).join('|');
const described = `${t(locale, 'play.cradle')} — ${labels.join(' · ')}. ${t(locale, 'play.cradleHint')}`;
---

<figure class="cradle">
  <canvas data-cradle data-icons={glyphs} role="img" aria-label={described}></canvas>
</figure>

<script is:inline src="/about-play.js"></script>

<style>
  .cradle {
    display: grid;
    position: sticky;
    top: var(--space-m);
    margin: 0;
  }

  canvas {
    width: 100%;
    height: auto;
    min-height: 16rem;
    aspect-ratio: 2.2 / 1;
    touch-action: none;
    cursor: grab;
  }

  canvas:active {
    cursor: grabbing;
  }
</style>
