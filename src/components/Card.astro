---
/**
 * Card — generic bordered surface. Border, not shadow; subtle radius.
 * The palette system: each kind of content owns a hue (the card's accent).
 */
interface Props {
  /** HTML tag to render ('article', 'li', 'div'…). */
  as?: 'article' | 'li' | 'div';
  /** Extra data-* attributes (used by the CSS-only project filters). */
  dataAttrs?: Record<string, string>;
  /** Duplicate of another card (marquee clone): hidden from assistive tech. */
  ariaHidden?: boolean;
  /** Palette accent for this kind of content. */
  accent?: string;
}

const { as = 'article', dataAttrs = {}, ariaHidden, accent } = Astro.props;
const Tag = as;
---

<Tag
  class="card"
  {...dataAttrs}
  aria-hidden={ariaHidden ? 'true' : undefined}
  style={accent ? `--card-accent: ${accent}` : undefined}
><slot /></Tag>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    height: 100%;
    padding: var(--space-s);
    background-color: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius);
    transition: border-color var(--duration) var(--ease);
    list-style: none;
  }

  .mark {
    --mark-color: var(--card-accent, var(--color-accent));
    margin-bottom: var(--space-3xs);
  }

  .card:hover {
    border-color: color-mix(in srgb, var(--color-primary) 35%, var(--color-border));
  }
</style>
