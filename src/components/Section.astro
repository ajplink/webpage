---
/**
 * Section — titled region with an optional "view all" link and a hand-drawn
 * squiggle underline in the section's accent colour (the palette system:
 * each kind of content owns a hue).
 */
import Squiggle from './Squiggle.astro';

interface Props {
  title: string;
  /** Unique id, used by aria-labelledby. */
  id: string;
  href?: string;
  linkLabel?: string;
  /** Palette accent for the squiggle (any valid CSS colour). */
  accent?: string;
}

const { title, id, href, linkLabel, accent } = Astro.props;
---

<section class="section" aria-labelledby={id} style={accent ? `--section-accent: ${accent}` : undefined}>
  <div class="container">
    <div class="section-head">
      <div class="section-title">
        <div class="section-heading">
          <h2 id={id}>{title}</h2>
        </div>
        <Squiggle class="section-squiggle" />
      </div>
      {href && linkLabel && <a class="link-arrow" href={href}>{linkLabel}</a>}
    </div>
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block: var(--space-l);
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-m);
  }

  .section-title {
    display: grid;
    gap: var(--space-3xs);
  }

  .section-heading {
    display: flex;
    gap: var(--space-2xs);
    align-items: center;
  }

  .section-title :global(.section-squiggle) {
    width: min(12rem, 60%);
    color: var(--section-accent, var(--color-accent));
  }
</style>
