# Security and cache headers for static hosts (Cloudflare Pages / Netlify format).
#
# Site-wide policy: no third-party requests, no cookies, no analytics.
# HTML is served with the host's default revalidation (ETag + cheap 304s),
# hashed assets under /_astro/ are immutable.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://example.org; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; manifest-src 'self'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Resource-Policy: same-origin

# Hashed build assets (CSS/JS/fonts/images emitted by Vite): cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Static images and the favicon change rarely.
/og-placeholder.png
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800

